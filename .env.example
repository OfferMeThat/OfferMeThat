# Supabase API URL (HTTPS, e.g. https://xxxxx.supabase.co). From Dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=your-project-url
# Anon/public key from Dashboard → Project Settings → API (not the PostgreSQL connection string).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
